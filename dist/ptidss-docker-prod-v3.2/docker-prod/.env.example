# ============================================================
# PTIDSS 生产部署配置模板（docker-prod）
# 用法：cp .env.example .env 后修改，切勿将 .env 提交到版本库
# ============================================================

# 数据库密码（生产必须改为强随机串；与 init-db.sh 建库密码一致）
DB_PASSWORD=ptidss

# JWT 令牌密钥（生产必须改为强随机串，例：openssl rand -base64 48）
TOKEN_SECRET=ptidss-jwt-secret-key-2026-change-me-in-production

# 登录验证码开关（生产保持 true）
CAPTCHA_ENABLED=true

# 前端对外端口（默认 80；服务器 80 被占用时改 8080 等）
FRONT_PORT=80

# 云 RDS 场景：连接云库时置 require（应用容器与云库之间走 SSL）
# DB_SSLMODE=require

# 等保边界：配置为实际前端访问域名白名单（逗号分隔），禁止保留 *
# CORS_ALLOWED_ORIGINS=https://ptidss.example.com
