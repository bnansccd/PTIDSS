/* 环节进度条 */
.steps {
  display: flex;
  padding: 20rpx 0;
}

.step {
  flex: 1;
  position: relative;
  text-align: center;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin: 0 auto 12rpx;
  background: #c3cad6;
  z-index: 2;
  position: relative;
}

.step-dot.completed {
  background: #1d8a4e;
}

.step-dot.current {
  background: #1f6fb8;
  box-shadow: 0 0 0 8rpx rgba(31, 111, 184, 0.15);
}

.step-line {
  position: absolute;
  top: 11rpx;
  left: 50%;
  width: 100%;
  height: 3rpx;
  background: #e3e7ee;
}

.step-name {
  font-size: 22rpx;
  color: #7a8599;
}

.step-name.current {
  color: #1f3a5f;
  font-weight: 600;
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  position: sticky;
  bottom: 0;
  background: #f5f6fa;
}

.action-btn {
  flex: 1;
  margin: 0 12rpx;
}

.comment {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}
