/* PTIDSS 移动端小程序全局样式（750rpx 适配，对齐 NFR-26） */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #2b3245;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 58, 95, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3a5f;
  margin-bottom: 16rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  color: #1f3a5f;
  background: #e8eef7;
}

.tag-blue { color: #1f6fb8; background: #e3f0fc; }
.tag-green { color: #1d8a4e; background: #e2f5ea; }
.tag-orange { color: #c2711a; background: #fdf0dd; }
.tag-red { color: #c0392b; background: #fdecea; }
.tag-gray { color: #7a8599; background: #eef0f4; }

/* 次级文本 */
.muted { color: #7a8599; font-size: 24rpx; }

/* 按钮 */
.btn {
  display: block;
  text-align: center;
  background: #1f3a5f;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  margin: 24rpx 0;
}

.btn::after { border: none; }

.btn-primary { background: #1f3a5f; }
.btn-danger { background: #c0392b; }
.btn-plain {
  background: #ffffff;
  color: #1f3a5f;
  border: 2rpx solid #1f3a5f;
}
.btn-disabled { background: #c3cad6; color: #ffffff; }

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #aab2c0;
  font-size: 26rpx;
}

/* 分段切换 */
.seg {
  display: flex;
  background: #e9edf3;
  border-radius: 12rpx;
  padding: 6rpx;
  margin: 20rpx 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 64rpx;
  color: #7a8599;
  border-radius: 10rpx;
}

.seg-item.active {
  background: #ffffff;
  color: #1f3a5f;
  font-weight: 600;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.row:last-child { border-bottom: none; }

.row-left { flex: 1; min-width: 0; }
.row-title { font-size: 28rpx; color: #2b3245; }
.row-sub { font-size: 24rpx; color: #7a8599; margin-top: 6rpx; }
.row-right { margin-left: 16rpx; text-align: right; }

/* 未读红点 */
.dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e02424;
  margin-left: 8rpx;
}

/* 输入框 */
.input {
  background: #f3f5f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

/* 表单标签 */
.form-label {
  font-size: 26rpx;
  color: #5a6478;
  margin-bottom: 12rpx;
}

/* 加载底部 */
.loading-more {
  text-align: center;
  color: #aab2c0;
  font-size: 24rpx;
  padding: 20rpx 0;
}

/* 弹层遮罩 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 75vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f3a5f;
  text-align: center;
  margin-bottom: 24rpx;
}
