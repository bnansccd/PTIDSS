<view class="login-page">
  <view class="logo">
    <view class="logo-icon">PT</view>
    <view class="logo-title">电力交易智能辅助决策系统</view>
    <view class="logo-sub">移动端 · 行情 / 预警 / 审批 / 复盘</view>
  </view>

  <view class="form">
    <view class="form-label">账号</view>
    <input class="input" placeholder="请输入账号" value="{{username}}" data-field="username" bindinput="onInput" />
    <view class="form-label">密码</view>
    <input class="input" password placeholder="请输入密码" value="{{password}}" data-field="password" bindinput="onInput" />

    <block wx:if="{{showCaptcha}}">
      <view class="form-label">验证码</view>
      <view class="captcha-row">
        <input class="input captcha-input" placeholder="请输入验证码" value="{{captchaCode}}" data-field="captchaCode" bindinput="onInput" />
        <image wx:if="{{captchaImage}}" class="captcha-img" src="{{captchaImage}}" mode="aspectFit" bindtap="loadCaptcha" />
      </view>
    </block>

    <button class="btn {{loading ? 'btn-disabled' : ''}}" bindtap="doLogin">登 录</button>
    <view class="captcha-link muted" wx:if="{{!showCaptcha}}" bindtap="loadCaptcha">遇到验证码？点击加载</view>
  </view>

  <view class="footer muted">服务地址：{{baseUrl}}（可在 utils/request.js 配置）</view>
</view>
