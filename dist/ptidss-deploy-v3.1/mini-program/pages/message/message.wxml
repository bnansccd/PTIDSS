<view class="page">
  <scroll-view scroll-x class="tabs">
    <view class="tab {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key"
      data-index="{{index}}" bindtap="onTab">{{item.name}}</view>
  </scroll-view>

  <view class="unread-bar">
    <switch checked="{{unreadOnly}}" bindchange="onUnreadSwitch" color="#1f3a5f" />
    <text class="muted">只看未读</text>
    <text class="muted total">共 {{total}} 条</text>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-index="{{index}}" bindtap="onItemTap">
    <view class="row">
      <view class="row-left">
        <view class="row-title">
          <text class="tag tag-blue">{{item.msgTypeName}}</text>{{item.title}}
          <text wx:if="{{item.isUnread}}" class="dot"></text>
        </view>
        <view class="row-sub">{{item.content}}</view>
      </view>
      <view class="row-right muted">{{item.time}}</view>
    </view>
  </view>

  <view wx:if="{{!list.length && !loading}}" class="empty">暂无消息</view>
  <view wx:if="{{loading}}" class="loading-more">加载中…</view>
  <view wx:if="{{finished && list.length}}" class="loading-more">已加载全部</view>

  <!-- 消息详情 -->
  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail"></view>
  <view class="sheet" wx:if="{{detail}}">
    <view class="sheet-title">{{detail.title}}</view>
    <view class="tag tag-blue">{{detail.msgTypeName}}</view>
    <view class="muted" style="margin: 16rpx 0">{{detail.time}}</view>
    <view style="line-height: 1.7">{{detail.content}}</view>
    <button class="btn btn-plain" bindtap="closeDetail">关闭</button>
  </view>
</view>
