.tabs {
  white-space: nowrap;
  background: #ffffff;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 58, 95, 0.06);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  display: inline-block;
  font-size: 26rpx;
  color: #7a8599;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: #f0f2f6;
}

.tab.active {
  background: #1f3a5f;
  color: #ffffff;
  font-weight: 600;
}

.summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 10rpx;
  line-height: 1.5;
}
