<view class="page">
  <!-- 用户信息卡 -->
  <view class="user-card" wx:if="{{user}}">
    <view class="avatar">{{avatarText}}</view>
    <view class="user-info">
      <view class="user-name">{{user.displayName}}</view>
      <view class="user-sub">{{user.username}} · {{user.orgCode}}</view>
      <view class="tag tag-blue">{{rolesText}}</view>
    </view>
  </view>

  <!-- 区域切换 -->
  <view class="card" wx:if="{{regions.length > 1}}">
    <picker range="{{regions}}" value="{{regionIndex}}" bindchange="onRegionChange">
      <view class="row">
        <view class="row-left">
          <view class="row-title">当前区域</view>
          <view class="row-sub">数据按区域隔离（X-Region-Code 多省路由）</view>
        </view>
        <view class="row-right"><text class="tag tag-blue">{{regions[regionIndex]}}</text></view>
      </view>
    </picker>
  </view>

  <!-- 预警推送入口 -->
  <view class="card" bindtap="goMessage">
    <view class="row">
      <view class="row-left">
        <view class="row-title">预警推送</view>
        <view class="row-sub">消息中心 · 30 秒自动刷新</view>
      </view>
      <view class="row-right">
        <text class="tag {{unreadTotal ? 'tag-red' : 'tag-gray'}}">{{unreadTotal ? unreadTotal + ' 条未读' : '无未读'}}</text>
      </view>
    </view>
  </view>

  <!-- 订阅设置（PRD FR-PL-05 ⑤） -->
  <view class="card">
    <view class="card-title">消息订阅设置</view>
    <view class="row" wx:for="{{subs}}" wx:key="key" data-index="{{index}}" style="align-items: flex-start">
      <view class="row-left">
        <view class="row-title">{{item.name}}</view>
        <view class="row-sub">{{item.desc}}</view>
      </view>
      <switch checked="{{item.on}}" bindchange="onSubSwitch" data-index="{{index}}" color="#1f3a5f" />
    </view>
    <view class="muted" style="padding-top: 8rpx">说明：当前以消息中心站内信方式推送（对齐 NFR-09 ≤30s）；微信订阅消息通道需公众平台资质，属上线后动作。</view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="row">
      <view class="row-left">
        <view class="row-title">服务地址</view>
        <view class="row-sub">{{baseUrl}}</view>
      </view>
    </view>
    <view class="row">
      <view class="row-left">
        <view class="row-title">版本</view>
        <view class="row-sub">M7 移动端 v1.0 · PTIDSS V2.6</view>
      </view>
    </view>
  </view>

  <button class="btn btn-danger" bindtap="doLogout">退出登录</button>
</view>
