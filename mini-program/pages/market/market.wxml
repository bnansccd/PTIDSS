<view class="page">
  <!-- 日期与区域 -->
  <view class="card head-card">
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="row">
        <view class="row-left">
          <view class="row-title">行情日期</view>
          <view class="row-sub">{{date}}（点击切换）</view>
        </view>
        <view class="tag tag-blue">{{region}}</view>
      </view>
    </picker>
  </view>

  <!-- 现货价格 -->
  <view class="card">
    <view class="card-title">现货电价（{{spotStage === 'day_ahead' ? '日前' : '实时'}}）</view>
    <view class="seg">
      <view class="seg-item {{spotStage === 'day_ahead' ? 'active' : ''}}" data-stage="day_ahead" bindtap="onSpotStage">日前</view>
      <view class="seg-item {{spotStage === 'real_time' ? 'active' : ''}}" data-stage="real_time" bindtap="onSpotStage">实时</view>
    </view>
    <view class="stats">
      <view class="stat"><view class="stat-value">{{spotStats.current}}</view><view class="stat-label">最新价（元/MWh）</view></view>
      <view class="stat"><view class="stat-value">{{spotStats.avg}}</view><view class="stat-label">日均价</view></view>
      <view class="stat"><view class="stat-value">{{spotStats.max}}</view><view class="stat-label">最高</view></view>
      <view class="stat"><view class="stat-value">{{spotStats.min}}</view><view class="stat-label">最低</view></view>
    </view>
    <canvas type="2d" id="priceChart" class="chart"></canvas>
  </view>

  <!-- 供需形势 -->
  <view class="card">
    <view class="card-title">供需形势（最新时点）</view>
    <view class="stats">
      <view class="stat"><view class="stat-value">{{supply.loadValue}}</view><view class="stat-label">负荷</view></view>
      <view class="stat"><view class="stat-value">{{supply.availableCapacity}}</view><view class="stat-label">可用能力</view></view>
      <view class="stat"><view class="stat-value">{{supply.renewableOutput}}</view><view class="stat-label">新能源出力</view></view>
    </view>
  </view>

  <!-- 中长期价格 -->
  <view class="card">
    <view class="card-title">中长期成交价格</view>
    <view class="seg">
      <view class="seg-item {{midlongVariety === 'weekly' ? 'active' : ''}}" data-variety="weekly" bindtap="onMidlongVariety">周</view>
      <view class="seg-item {{midlongVariety === 'monthly' ? 'active' : ''}}" data-variety="monthly" bindtap="onMidlongVariety">月</view>
      <view class="seg-item {{midlongVariety === 'annual' ? 'active' : ''}}" data-variety="annual" bindtap="onMidlongVariety">年</view>
    </view>
    <view class="row" wx:for="{{midlongList}}" wx:key="ts">
      <view class="row-left">
        <view class="row-title">{{item.ts}}</view>
      </view>
      <view class="row-right">
        <view class="row-title">{{item.price}} 元/MWh</view>
        <view class="row-sub">成交量 {{item.volume}} MWh</view>
      </view>
    </view>
    <view wx:if="{{!midlongList.length}}" class="empty">暂无中长期行情</view>
  </view>

  <!-- 量价热力图（近 7 天 × 24 时段） -->
  <view class="card" wx:if="{{heatGrid.length}}">
    <view class="card-title">量价热力图（近 7 天 × 24 时段，元/MWh）</view>
    <view class="heat">
      <view class="heat-col" wx:for="{{heatGrid}}" wx:for-item="row" wx:for-index="d" wx:key="d">
        <view class="heat-cell" wx:for="{{row}}" wx:for-item="v" wx:for-index="h" wx:key="h"
          style="background: {{v >= heatMax ? '#1f3a5f' : heatMin === heatMax ? '#dce6f2' : 'rgba(31, 58, 95, ' + (0.08 + 0.62 * (v - heatMin) / (heatMax - heatMin)) + ')'}}"></view>
      </view>
    </view>
    <view class="heat-labels">
      <view class="heat-date" wx:for="{{heatDates}}" wx:key="*this">{{item.substring(5)}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-more">加载中…</view>
</view>
