.head-card {
  margin-top: 20rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 25%;
  text-align: center;
  padding: 12rpx 0;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f3a5f;
}

.stat-label {
  font-size: 22rpx;
  color: #7a8599;
  margin-top: 6rpx;
}

.chart {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
}

/* 热力图 */
.heat {
  display: flex;
}

.heat-col {
  flex: 1;
  margin-right: 4rpx;
}

.heat-col:last-child {
  margin-right: 0;
}

.heat-cell {
  height: 26rpx;
  margin-bottom: 4rpx;
  border-radius: 4rpx;
}

.heat-labels {
  display: flex;
  margin-top: 8rpx;
}

.heat-date {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: #7a8599;
}
