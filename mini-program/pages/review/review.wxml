<view class="page">
  <scroll-view scroll-x class="tabs">
    <view class="tab {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key"
      data-index="{{index}}" bindtap="onTab">{{item.name}}</view>
  </scroll-view>

  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
    <view class="row">
      <view class="row-left">
        <view class="row-title">
          <text class="tag tag-green">{{item.reportTypeName}}</text>
          <text class="tag {{item.status === 'published' ? 'tag-blue' : 'tag-gray'}}">{{item.statusName}}</text>
        </view>
        <view class="row-sub">{{item.period}}</view>
        <view class="row-sub summary">{{item.summary}}</view>
      </view>
    </view>
    <view class="muted" style="margin-top: 12rpx">生成时间：{{item.createdAt}}</view>
  </view>

  <view wx:if="{{!list.length && hasLoaded}}" class="empty">暂无复盘报告</view>
  <view wx:if="{{loading}}" class="loading-more">加载中…</view>
</view>
