.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: #1f3a5f;
  color: #ffffff;
  font-size: 28rpx;
  padding: 22rpx 36rpx;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 58, 95, 0.35);
  z-index: 20;
}

.auto-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.auto-row switch {
  transform: scale(0.8);
  margin-right: -8rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
}

.row-sub {
  margin-top: 8rpx;
}
