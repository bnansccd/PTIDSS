.kv-value {
  max-width: 60%;
  text-align: right;
  font-size: 24rpx;
  color: #2b3245;
  word-break: break-all;
}

.layer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f3a5f;
  padding: 16rpx 0 8rpx;
  border-top: 1rpx solid #f0f2f6;
}

.layer-title:first-child {
  border-top: none;
}

.suggest {
  padding: 12rpx 0;
  line-height: 1.6;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f2f6;
}

.suggest:last-child {
  border-bottom: none;
}

.share-tip {
  text-align: center;
}
