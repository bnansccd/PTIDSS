    @Override
    public ${ClassName}VO select${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaType} ${pkColumn.javaField}) {
        ${ClassName} ${className}=this.${className}Dao.getById(${pkColumn.javaField});
        ${ClassName}VO vo=null;
        if (StringUtils.isNotNull(${className})){
            vo=new ${ClassName}VO();
            BeanUtils.copyProperties(${className},vo);
#if($table.sub)
            List<${subClassName}VO> ${subclassName}VOs = this.${subclassName}Service.findBy${subTableFkClassName}(${pkColumn.javaField});
            vo.set${subClassName}VOs(${subclassName}VOs);
#end
        }
        return vo;
    }


#if($table.crud || $table.sub)
    @Autowired
    public PageVO<${ClassName}VO> select${ClassName}Page(${ClassName}SearchDTO dto){
        Page<${ClassName}> page = this. ${className}Dao.findPage(dto);
        PageVO<${ClassName}VO> pageVO = PageUtils.convertPageVo(page,${ClassName}VO.class);
#if($table.sub)
        List<${ClassName}VO> vos = pageVO.getRecords();
        if (StringUtils.isNotEmpty(vos)){
            List<${pkColumn.javaType}> ${pkColumn.javaField}s=vos.stream().map(${ClassName}VO::get${pkColumn.capJavaField}).distinct().collect(Collectors.toList());
            List<${subClassName}VO> ${subclassName}VOs = this.${subclassName}Service.findBy${subTableFkClassName}s(${pkColumn.javaField}s);
            if (StringUtils.isNotEmpty(${subclassName}VOs)){
                for (${ClassName}VO vo : vos){
                    List<${subClassName}VO> ${subclassName}VOList = ${subclassName}VOs.stream()
                            .filter(${subclassName}Stream -> vo.get${pkColumn.capJavaField}().equals(${subclassName}Stream.get${subTableFkClassName}()) )
                            .collect(Collectors.toList());
                    vo.set${subClassName}VOs(${subclassName}VOList);
                }
            }
        }
#end
        return pageVO;
    }
