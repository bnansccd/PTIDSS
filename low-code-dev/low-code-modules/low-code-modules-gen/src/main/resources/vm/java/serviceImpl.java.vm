    @Transactional(rollbackFor = Exception.class)
    @Override
    public ResultVO insert${ClassName}(${ClassName}DTO dto) {
        ${ClassName} ${className}=new ${ClassName}();
        BeanUtils.copyProperties(dto, ${className});
        if (this.${className}Dao.save(${className})){
            return ResultVO.success();
        }
        return ResultVO.fail();
    }


    @Transactional(rollbackFor = Exception.class)
    @Override
    public ResultVO update${ClassName}(${pkColumn.javaType} ${pkColumn.javaField},${ClassName}DTO dto) {
        ${ClassName} ${className} = this.${className}Dao.getById(${pkColumn.javaField});
        if (StringUtils.isNull(${className})){
            throw new ServiceException(ResultEnum.getMsg(ResultEnum.NOT_FOUND,"$table.tableComment"));
        }
        BeanUtils.copyProperties(dto,${className});
        if (this.${className}Dao.updateById(${className})){
            return ResultVO.success();
        }
        return ResultVO.fail();
    }


    @Transactional(rollbackFor = Exception.class)
    @Override
    public ResultVO delete${ClassName}By${pkColumn.capJavaField}s(List<${pkColumn.javaType}> ${pkColumn.javaField}s) {
        this.${className}Dao.removeBatchByIds(${pkColumn.javaField}s);
        return ResultVO.success();
    }

