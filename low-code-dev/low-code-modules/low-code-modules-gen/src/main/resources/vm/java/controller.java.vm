package ${packageName}.controller.web;

import java.util.List;
import javax.servlet.http.HttpServletResponse;

import com.troy.common.core.constant.UrlConstants;
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiImplicitParam;
import io.swagger.annotations.ApiOperation;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import ${packageName}.service.${ClassName}Service;
import com.troy.common.core.domain.ResultVO;
import ${packageName}.domain.DTO.${ClassName}SearchDTO;
import ${packageName}.domain.VO.${ClassName}VO;
import ${packageName}.domain.DTO.${ClassName}DTO;
import com.troy.common.log.annotation.Log;
import com.troy.common.core.utils.poi.ExcelUtil;



/**
 * @Auther: ${author}
 * @Date: ${datetime}
 * @Description: ${functionName}Controller
 * @Version: 1.0.0
 */
@Api(tags = "${functionName}")
@RestController
@RequestMapping(UrlConstants.WEB_RESTFUL)
public class ${ClassName}Controller {

    @Autowired
    private ${ClassName}Service ${className}Service;


    @ApiOperation(value = "查询${functionName}列表")
    @GetMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}")
#if($table.crud || $table.sub)
    public ResultVO<PageVO<${ClassName}VO>>  select${ClassName}Page(${ClassName}SearchDTO dto) {
        PageVO<${ClassName}VO> pageVO = ${className}Service.select${ClassName}Page(dto);
        return ResultVO.success(pageVO);
    }
#elseif($table.tree)
        public ResultVO<List<${ClassName}VO>> list(${ClassName}SearchDTO dto) {
            List<${ClassName}VO> vos = ${className}Service.select${ClassName}List(dto);
            return ResultVO.success(vos);
        }
#end

    @ApiOperation(value = "导出${functionName}列表")
    @Log(title = "${functionName}", businessType = BusinessType.EXPORT)
    @PostMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}/export")
    public void export(HttpServletResponse response, ${ClassName}SearchDTO dto) {
        List<${ClassName}VO> vos = ${className}Service.export${ClassName}(dto);
        ExcelUtil<${ClassName}VO> util = new ExcelUtil<${ClassName}VO>(${ClassName}VO.class);
        util.exportExcel(response, vos, "${functionName}数据");
    }

    @ApiOperation(value = "获取${functionName}详细信息")
    @GetMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}/{${pkColumn.javaField}}")
    @ApiImplicitParam(value = "主键",name = "${pkColumn.javaField}",required = true,paramType = "path")
    public ResultVO<List<${ClassName}VO>> getInfo(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField}) {
        return ResultVO.success(${className}Service.select${ClassName}By${pkColumn.capJavaField}(${pkColumn.javaField}));
    }

    @ApiOperation(value = "新增${functionName}")
    @Log(title = "${functionName}", businessType = BusinessType.INSERT)
    @PostMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}")
    public ResultVO add(@Validated @RequestBody ${ClassName}DTO dto) {
        return ${className}Service.insert${ClassName}(dto);
    }

    @ApiOperation(value = "修改${functionName}")
    @Log(title = "${functionName}", businessType = BusinessType.UPDATE)
    @PutMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}/{${pkColumn.javaField}}")
    @ApiImplicitParam(value = "主键",name = "${pkColumn.javaField}",required = true,paramType = "path")
    public ResultVO edit(@PathVariable("${pkColumn.javaField}") ${pkColumn.javaType} ${pkColumn.javaField},@Validated @RequestBody ${ClassName}DTO dto) {
        return ${className}Service.update${ClassName}(${pkColumn.javaField},dto);
    }

    @ApiOperation(value = "批量删除${functionName}")
    @Log(title = "${functionName}", businessType = BusinessType.DELETE)
    @DeleteMapping(UrlConstants.RESTFUL_VERSION_V1+"${businessName}/{${pkColumn.javaField}s}")
    @ApiImplicitParam(value = "批量主键",name = "${pkColumn.javaField}s",required = true,paramType = "path")
    public ResultVO remove${pkColumn.javaField}s(@PathVariable List< ${pkColumn.javaType}> ${pkColumn.javaField}s) {
        return ${className}Service.delete${ClassName}By${pkColumn.capJavaField}s(${pkColumn.javaField}s);
    }

}
